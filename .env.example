# Anthropic API key for AI players
ANTHROPIC_API_KEY=your-api-key-here

# Neon Postgres database URL (optional - falls back to in-memory without it)
# Get this from Vercel Marketplace Neon integration or Neon Console
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
